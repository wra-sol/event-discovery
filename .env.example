# Copy to .env and fill in values. Never commit .env.

# --- Database (optional) ---
# When set, authentication uses PostgreSQL instead of auth.db on disk.
# Discovery/event data still uses per-account SQLite under OUTPUT_DIR unless you use CLI-only workflows.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Agent and scheduled crawl machine auth (optional) ---
# Broad account-scoped agent API token for source/settings management:
#   Authorization: Bearer <this value>
#   X-Agent-Account-Id: <numeric account id>
# Grants access to website/source CRUD, source discovery, discovery settings, delivery settings,
# and automation routes.
# Use a different long random string from EVENTS_CRAWL_API_TOKEN.
# EVENTS_AGENT_API_TOKEN=
#
# Narrow crawl token for scheduled crawls/brief triage only:
# When set, POST /api/crawl-jobs, GET /api/daily-brief, PATCH /api/automation/events*, and crawl job GETs accept:
#   Authorization: Bearer <this value>
#   X-Crawl-Account-Id: <numeric account id>
# alongside normal session cookies. Use a long random string (32+ bytes hex).
# EVENTS_CRAWL_API_TOKEN=
# DISCOVERY_ACCOUNT_ID=1

# --- Web security (required in production) ---
# Set EVENT_DISCOVERY_ENV=production (or EVENT_DISCOVERY_PRODUCTION=1) to enforce stricter startup checks.
# EVENT_DISCOVERY_ENV=production
EVENTS_SESSION_SECRET=
# EVENTS_SESSION_HTTPS_ONLY=1
# Comma-separated origins for browser API calls (same-origin UI can leave unset for defaults).
# EVENTS_CORS_ORIGINS=https://your-app.example

# --- Public sign-up & abuse control ---
# EVENT_DISCOVERY_ALLOW_SIGNUP=1
# Max login attempts per IP per window before 429 (default 25 / 300s).
# EVENTS_AUTH_LOGIN_MAX_ATTEMPTS=25
# EVENTS_AUTH_LOGIN_WINDOW_SECONDS=300
# EVENTS_AUTH_SIGNUP_MAX_ATTEMPTS=10
# EVENTS_AUTH_SIGNUP_WINDOW_SECONDS=3600

# --- Operator / crawl ---
# EVENTS_WEB_READ_ONLY=0
# EVENT_DISCOVERY_DISABLE_AUTH=0
# WEBHOOK_URL=          # POST after crawl; body includes brief_pending_count when available
# EVENT_DISCOVERY_CONFIG=event_discovery/config.campaign.example.yaml

# --- Railway cron service (separate stateless service) ---
# Runs: python -m event_discovery cron-run
# See docs/CRON.md
# EVENT_DISCOVERY_BASE_URL=https://your-app.up.railway.app
# BRIEF_WEBHOOK_URL is an optional legacy fallback if account webhooks are not configured in the UI.
# BRIEF_WEBHOOK_URL=https://hooks.slack.com/services/...
# CRON_POLL_SECONDS=5
# CRON_TIMEOUT_SECONDS=900
# CRON_SKIP_WEBHOOK_IF_EMPTY=0

# --- LLM (discover-source CLI only) ---
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# LLM_API_KEY=

# --- Paths / Railway volume ---
# OUTPUT_DIR=/data
# RAILWAY_VOLUME_MOUNT_PATH=/data
